# ==============================================================================
# NovaMobile ERP / E-Commerce Backend (NestJS) — Production Environment Config
# Target: Single Hostinger KVM VPS (Ubuntu 22.04/24.04), Nginx Reverse Proxy
# ==============================================================================

# Server Network Configuration
# NestJS listens on port 4000 locally behind Nginx reverse proxy (api.mobilehubbd.tech)
PORT=4000
NODE_ENV=production

# Database Connection (Local PostgreSQL on VPS)
# Format: postgresql://<db_user>:<db_password>@localhost:5432/<db_name>?schema=public
DATABASE_URL="postgresql://novamobile_user:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/novamobile?schema=public"

# Cryptographic JWT Authentication Secrets (MANDATORY: Minimum 32 characters each)
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOMLY_GENERATED_64_CHAR_ACCESS_SECRET_KEY"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOMLY_GENERATED_64_CHAR_REFRESH_SECRET_KEY"
JWT_REFRESH_EXPIRY="7d"

# CORS & Domain Routing Configuration
# Comma-separated list of permitted frontend origins accessing the API.
# Disallowed origins will be rejected cleanly without exposing stack traces.
ALLOWED_ORIGINS="https://mobilehubbd.tech,https://www.mobilehubbd.tech"
FRONTEND_URL="https://mobilehubbd.tech"
REVALIDATION_SECRET="REPLACE_WITH_RANDOMLY_GENERATED_64_CHAR_SECRET_KEY"

# API_URL is used in payment gateway callback/IPN generation (SSLCommerz & bKash).
# The code appends paths directly (e.g. `${apiBase}/payments/...`), so API_URL
# MUST explicitly include the `/api/v1` global prefix.
API_URL="https://api.mobilehubbd.tech/api/v1"

# Internal URLs & Headless PDF/Invoice Rendering
# INTERNAL_FRONTEND_URL is used by backend Puppeteer to render POS receipts via local loopback.
INTERNAL_FRONTEND_URL="http://localhost:3000"

# Path to system Chromium executable on Ubuntu/Debian VPS for invoice generation.
# Install with: sudo apt-get install -y chromium-browser (or chromium)
CHROME_BIN="/usr/bin/chromium-browser"
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"

# Upload Storage Configuration (Local Disk Storage)
# Dedicated persistent directory for user/product uploads outside the application repo.
# Must be owned by the node/deploy user: chown -R www-data:www-data /var/www/novamobile/uploads
# Served publicly by Nginx at: https://api.mobilehubbd.tech/uploads/...
UPLOAD_ROOT="/var/www/novamobile/uploads"

# Optional: Cloudflare R2 Object Storage (Leave blank to use local UPLOAD_ROOT above)
# If provided, file uploads stream directly to R2 bucket instead of local VPS disk.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Payment Gateways (SSLCommerz) — Inactive for launch (Credentials blank, *_IS_LIVE=false)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASS=""
SSLCOMMERZ_IS_LIVE=false

# Payment Gateways (bKash Tokenized Checkout) — Inactive for launch (Credentials blank, *_IS_LIVE=false)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_IS_LIVE=false

# Database Seeding Configuration
# Required when running "npx prisma db seed" in production
SEED_ADMIN_EMAIL="admin@mobilehubbd.tech"
SEED_ADMIN_PASSWORD="REPLACE_WITH_STRONG_SUPERADMIN_PASSWORD_MIN_12_CHARS"
# Set to false to strictly prevent creating dummy/demo staff accounts in production
SEED_DEMO=false
