# ==============================================================================
# NovaMobile Storefront & Admin Frontend (Next.js) — Production Environment
# Target: Single Hostinger KVM VPS, Next.js server on port 3000 behind Nginx
# ==============================================================================
#
# IMPORTANT BUILD NOTE:
# Variables prefixed with NEXT_PUBLIC_* are inlined into the client-side JavaScript
# bundle at BUILD TIME (`npm run build`). If you modify either of these variables,
# you MUST recompile the application via `npm run build` before restarting pm2.
# ==============================================================================

# REST API Base URL with version prefix (used by frontend api client for data fetching)
# Note: No trailing slash!
NEXT_PUBLIC_API_URL=https://api.mobilehubbd.tech/api/v1

# Backend Server Root URL (used for resolving upload paths e.g. /uploads/... and static files)
# Note: No trailing slash!
NEXT_PUBLIC_BACKEND_URL=https://api.mobilehubbd.tech

# Internal Server-to-Server Backend URL (Used for fast SSR loopback fetching without hair-pinning)
INTERNAL_BACKEND_URL=http://localhost:4000

# Public Storefront Site URL (used for canonical URLs, metadata, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://mobilehubbd.tech

# Brand & Store Name display fallbacks (used across not-found and error boundary pages)
NEXT_PUBLIC_STORE_NAME=MobileHubBD
NEXT_PUBLIC_SITE_NAME=MobileHubBD

# Optional: On-demand ISR cache revalidation secret (Must match backend REVALIDATION_SECRET)
REVALIDATION_SECRET="REPLACE_WITH_RANDOMLY_GENERATED_64_CHAR_SECRET_KEY"

# Node environment flag
NODE_ENV=production
PORT=3000
